{
  "_comment": "Thresholds and patterns of the book pipeline (parser, assembler, chunker). See PipelineConfig.kt for what each one means. Patterns are Java regular expressions.",

  "marginTop": 0.08,
  "marginBottom": 0.08,
  "repetitionMinPages": 2,
  "repetitionShare": 0.3,
  "repetitionMinRun": 3,
  "headerFooterPatterns": ["^\\d+\\s+\\S.{0,40}$", "^.{0,40}\\s+\\d+$"],
  "pageNumberPatterns": [
    "^(?:page\\s+)?(?:\\d{1,4}|[ivxlcdm]{1,7})(?:\\s*(?:/|of)\\s*\\d{1,4})?$",
    "^[-–—]\\s*(?:\\d{1,4}|[ivxlcdm]{1,7})\\s*[-–—]$"
  ],
  "boilerplatePagePatterns": [
    "^(?:this\\s+page\\s+(?:has\\s+been\\s+|is\\s+)?(?:intentionally|deliberately)\\s+left\\s+blank\\.?)$",
    "^(?:\\[?\\s*blank\\s+page\\s*]?)$"
  ],
  "boilerplateLinePatterns": [
    "\\.(?:indd|qxd|qxp)\\b",
    "^\\d{1,2}/\\d{1,2}/\\d{2,4},?\\s+\\d{1,2}:\\d{2}(?::\\d{2})?\\s*(?:[ap]\\.?m\\.?)?$"
  ],

  "captionPatterns": [
    "^(?:figure|fig\\.|table|plate|chart|illustration|map|exhibit|diagram)\\s*[0-9ivxlc]+[a-z]?(?:[.:\\-–—]|\\s)"
  ],
  "captionGapEm": 1.5,
  "captionMaxLines": 3,
  "paragraphGapRatio": 1.3,
  "defaultLeadingEm": 1.2,
  "shortLineEm": 2.0,
  "figureMaxPageShare": 0.6,
  "indentEm": 0.8,
  "listContinuationEm": 0.5,
  "listLevelEm": 1.5,
  "columnGapEm": 1.0,
  "wordGapEm": 0.15,
  "minGutter": 8.0,
  "xyBandGapEm": 0.5,
  "xyColumnGapEm": 1.0,
  "xyMinColumnItems": 2,
  "xyMergeAlignedBands": true,
  "footnotesLast": true,
  "columnMinFlow": 0.3,
  "tableCellMaxRatio": 0.45,
  "tableCellMeanRatio": 0.3,
  "tableMaxFlow": 0.3,
  "headingSizeRatio": 1.15,
  "boldHeadingMaxWords": 12,
  "footnoteSizeRatio": 0.9,
  "footnoteZone": 0.6,
  "tierTolerance": 0.06,
  "bulletPattern": "^[•●○◦▪▫■□‣⁃∙·➢➤►▶✓✔→\\uE000-\\uF8FF]\\s*",
  "numberedPattern": "^\\(?(?:\\d{1,3}|[a-z]|[ivx]{1,5})[.)]\\s+\\S",
  "footnoteStartPattern": "^(?:\\d{1,3}|[*†‡§¹²³⁴⁵⁶⁷⁸⁹⁰]+)[.)]?\\s*\\S",

  "terminalPunctuation": ".!?:;\"”’…।॥。！？",
  "commonStandaloneWords": [],
  "standaloneMinCount": 2,

  "tocLinePattern": "^(.*?)(?:[\\s.·…_-]+(?:\\d{1,4}|[ivxlc]{1,6}))?[\\s.·…_-]*$",
  "leaderLinePattern": "^.*\\S[ .·…_]*[.·…_]{3,}[ .·…_]*(?:\\d{1,4}|[ivxlc]{1,6})$",
  "tocMinEntries": 2,

  "chunkMaxParagraphs": 3,
  "chunkMaxWords": 800,

  "weights": {
    "body": 1.0,
    "unknown": 0.2,
    "marginZone": 0.6,
    "repetition": 1.0,
    "pageNumberPattern": 1.1,
    "runningHeadPattern": 0.6,
    "footnoteLikePenalty": 0.8,
    "boilerplatePattern": 3.0,
    "strayMargin": 1.3,
    "headingTier": 1.5,
    "boldHeading": 1.2,
    "bullet": 2.0,
    "numbered": 1.5,
    "captionPattern": 1.2,
    "nearImage": 1.2,
    "insideFigure": 3.0,
    "footnoteZone": 0.9,
    "footnoteMark": 0.5,
    "footnoteContinues": 0.5,
    "tableCell": 4.0
  }
}
