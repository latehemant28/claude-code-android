<?xml version="1.0" encoding="utf-8"?>
<!-- Never back up or transfer the multi-gigabyte model file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
